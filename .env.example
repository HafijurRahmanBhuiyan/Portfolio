# Copy this file to .env only as a starting point:
#   cp .env.example .env
#
# .env is ignored by Git. Never commit it, paste it into an issue, or reuse its
# development values in production.
#
# =============================================================================
# LOCAL DEVELOPMENT (docker-compose.dev.yml)
# =============================================================================
# These values are development-only. The production validator rejects the
# dev-only/do-not-use fallbacks below.
PORT=3000
POSTGRES_PASSWORD=dev-only-postgres-password-do-not-use-0001
ADMIN_EMAIL=admin@example.invalid

# REQUIRED: generate the Argon2id hash from a password of at least 16
# characters. The helper reads stdin and prints only the hash:
#   node scripts/hash-admin-password.mjs
# Paste the single-line output below wrapped in single quotes, because
# Argon2id hashes contain '$':
#   ADMIN_PASSWORD_HASH='$argon2id$...'
ADMIN_PASSWORD_HASH=

# Development-only fallback. Replace it with a random value if you run the API
# outside Compose:
#   node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url')+'\n')"
SESSION_SECRET=dev-only-session-secret-do-not-use-in-production-0001

# HTTP localhost origins are allowed only in the development profile.
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
HTTPS_TERMINATED=false
NODE_ENV=development
APP_ENV=development

# Optional for one web instance. Set one shared value for every replica when
# Server Actions are introduced or the web tier is scaled.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# =============================================================================
# PRODUCTION (docker-compose.yml)
# =============================================================================
# Do not copy this file into production. Set every value through the hosting
# platform or secret manager. Missing values fail before containers start.
#
# NODE_ENV=production
# APP_ENV=production
# HTTPS_TERMINATED=true
# TRUSTED_ORIGINS=https://your-real-domain.example
# ADMIN_EMAIL=valid-mailbox@your-real-domain.example
# ADMIN_PASSWORD_HASH='<generated Argon2id hash>'
# SESSION_SECRET='<random base64url value, at least 43 characters>'
# POSTGRES_PASSWORD='<unique strong value, at least 24 bytes>'
# TRUST_PROXY_HOPS=1
# UPLOAD_DIR=/app/uploads
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY='<shared key for multiple web replicas>'
#
# TRUST_PROXY_HOPS must equal the exact number of trusted reverse proxies in
# front of the web service. HTTPS_TERMINATED=true is required, and every
# TRUSTED_ORIGINS entry must be an HTTPS origin with a real hostname.
#
# =============================================================================
# MANAGED PRODUCTION (Render API + Neon PostgreSQL + Vercel frontend)
# =============================================================================
# Set these on the Render Web Service. PORT is injected by Render; do not set
# it manually. DATABASE_URL must be the DIRECT Neon URL (connection pooling
# disabled) with sslmode=require; pooled -pooler hosts are rejected because
# startup migrations use a session-level advisory lock.
#
# NODE_ENV=production
# APP_ENV=production
# HTTPS_TERMINATED=true
# TRUSTED_ORIGINS=https://your-vercel-production-origin.example
# TRUST_PROXY_HOPS=1
# DATABASE_URL=<direct Neon URL with sslmode=require>
# ADMIN_EMAIL=<real admin email>
# ADMIN_PASSWORD_HASH=<real Argon2id hash>
# SESSION_SECRET=<real random base64url secret>
# UPLOAD_DIR=/var/data/uploads
#
# Attach a Render persistent disk at the exact UPLOAD_DIR path. The directory
# alone is ephemeral and does not survive deploys or restarts.
#
# Set these on the Vercel project (server-side only). Never create
# NEXT_PUBLIC_API_URL; browser code uses relative /api paths.
#
# API_INTERNAL_URL=https://your-render-service.onrender.com
# HTTPS_TERMINATED=true
